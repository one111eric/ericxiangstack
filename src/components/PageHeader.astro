---
interface Props {
  title: string;
  subtitle?: string;
  eyebrow?: string;
}
const { title, subtitle, eyebrow } = Astro.props;
---

<section class="border-b border-ink-200 dark:border-ink-800">
  <div class="container-page py-12 sm:py-16">
    {eyebrow && <p class="tag mb-3">{eyebrow}</p>}
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{title}</h1>
    {
      subtitle && (
        <p class="mt-3 max-w-2xl text-lg text-ink-600 dark:text-ink-300">
          {subtitle}
        </p>
      )
    }
  </div>
</section>
