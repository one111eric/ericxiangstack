---
import { site, navItems } from "../lib/site";
const year = new Date().getFullYear();
---

<footer class="border-t border-ink-200 dark:border-ink-800">
  <div
    class="container-page flex flex-col items-center justify-between gap-4 py-8
      sm:flex-row"
  >
    <p class="text-sm text-ink-500 dark:text-ink-400">
      &copy; {year} {site.author}. Built with Astro on Cloudflare.
    </p>

    <div class="flex items-center gap-4 text-sm">
      {
        navItems.slice(1).map((item) => (
          <a
            href={item.href}
            class="text-ink-500 hover:text-ink-900 dark:text-ink-400 dark:hover:text-white"
          >
            {item.label}
          </a>
        ))
      }
    </div>

    <div class="flex items-center gap-3">
      <a
        href={site.social.github}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
        class="text-ink-500 hover:text-ink-900 dark:text-ink-400 dark:hover:text-white"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M12 .5C5.7.5.5 5.7.5 12a11.5 11.5 0 0 0 7.9 10.9c.6.1.8-.2.8-.6v-2c-3.2.7-3.9-1.4-3.9-1.4-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.7 18.3 5 18.3 5c.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A11.5 11.5 0 0 0 23.5 12C23.5 5.7 18.3.5 12 .5z"
          ></path>
        </svg>
      </a>
    </div>
  </div>
</footer>
