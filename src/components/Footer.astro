---
import { site, navItems } from "../lib/site";
const year = new Date().getFullYear();
---

<footer class="border-t border-ink-200 dark:border-ink-800">
  <div
    class="container-page flex flex-col items-center justify-between gap-4 py-8
      sm:flex-row"
  >
    <p class="text-sm text-ink-500 dark:text-ink-400">
      &copy; {year} {site.author}. Built with Astro on Cloudflare.
    </p>

    <div class="flex items-center gap-4 text-sm">
      {
        navItems.slice(1).map((item) => (
          <a
            href={item.href}
            class="text-ink-500 hover:text-ink-900 dark:text-ink-400 dark:hover:text-white"
          >
            {item.label}
          </a>
        ))
      }
    </div>

    <div class="flex items-center gap-3">
      <a
        href={site.social.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn"
        class="text-ink-500 hover:text-ink-900 dark:text-ink-400 dark:hover:text-white"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"
          ></path>
        </svg>
      </a>
    </div>
  </div>
</footer>
