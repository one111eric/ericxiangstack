---
interface Props {
  title: string;
  description: string;
  tags?: string[];
  repo?: string;
  demo?: string;
  href?: string;
}
const { title, description, tags = [], repo, demo, href } = Astro.props;
---

<article class="card flex h-full flex-col">
  <h3 class="text-lg font-semibold">
    {
      href ? (
        <a class="hover:text-brand-600 dark:hover:text-brand-300" href={href}>
          {title}
        </a>
      ) : (
        title
      )
    }
  </h3>
  <p class="mt-2 flex-1 text-sm text-ink-600 dark:text-ink-300">{description}</p>

  {
    tags.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-2">
        {tags.map((t) => (
          <span class="tag">{t}</span>
        ))}
      </div>
    )
  }

  {
    (repo || demo) && (
      <div class="mt-4 flex gap-3 text-sm">
        {demo && (
          <a
            class="font-medium text-brand-600 hover:underline dark:text-brand-300"
            href={demo}
            target="_blank"
            rel="noopener noreferrer"
          >
            Live demo
          </a>
        )}
        {repo && (
          <a
            class="font-medium text-ink-600 hover:underline dark:text-ink-300"
            href={repo}
            target="_blank"
            rel="noopener noreferrer"
          >
            Source
          </a>
        )}
      </div>
    )
  }
</article>
