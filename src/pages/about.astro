---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";

const skills = [
  "Golang",
  "Python",
  "Databases",
  "AWS",
  "AI/ML"
];

const experience = [
  {
    role: "Senior Software Engineer",
    org: "Intuit",
    period: "2025/01 - Present",
    summary:
      "AI Agents and tools.",
  },
  {
    role: "Senior Software Engineer",
    org: "Comcast",
    period: "2015/07 - 2024/11",
    summary:
      "Workflow engine and home automation platform.",
  },
  {
    role: "Software Engineer",
    org: "Polywell Computers",
    period: "2012/07 - 2015/06",
    summary:
      "ERP, CRM and sales tools.",
  },
];

const education = [
  {
    degree: "Master of Science in Statistics",
    org: "CSUEB",
  },
  {
    degree: "Bachelor of Science in Computer Science",
    org: "CSUEB",
  },
];
---

<BaseLayout title="About" description="About Eric Xiang.">
  <PageHeader
    eyebrow="About"
    title="A bit about me"
    subtitle="Engineer, builder, and Path of Exile enthusiast."
  />

  <section class="container-page py-12">
    <div class="grid gap-12 lg:grid-cols-5">
      <div class="prose-links lg:col-span-3 space-y-4 text-ink-700 dark:text-ink-300">
        <p>
          I'm Eric, a software engineer in Bay Area.
          I like turning ideas into things people (including myself) can actually use.
          This site is where I collect my projects, the small utilities I build
          to scratch my own itches, and resources for games I enjoy.
        </p>
        <p>
          Outside of work I like to play Path of Exile, chess, basketball, a little bit of photography and piano.
        </p>
      </div>

      <aside class="lg:col-span-2 space-y-8">
        <div>
          <h2 class="text-sm font-semibold uppercase tracking-wide text-ink-500">
            Skills
          </h2>
          <div class="mt-3 flex flex-wrap gap-2">
            {skills.map((s) => <span class="tag">{s}</span>)}
          </div>
        </div>

        <div>
          <h2 class="text-sm font-semibold uppercase tracking-wide text-ink-500">
            Experience
          </h2>
          <ul class="mt-3 space-y-4">
            {
              experience.map((e) => (
                <li>
                  <p class="font-medium">
                    {e.role} &middot; {e.org}
                  </p>
                  <p class="text-xs text-ink-500">{e.period}</p>
                  <p class="mt-1 text-sm text-ink-600 dark:text-ink-300">
                    {e.summary}
                  </p>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h2 class="text-sm font-semibold uppercase tracking-wide text-ink-500">
            Education
          </h2>
          <ul class="mt-3 space-y-4">
            {
              education.map((e) => (
                <li>
                  <p class="font-medium">
                    {e.degree} &middot; {e.org}
                  </p>
                </li>
              ))
            }
          </ul>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
