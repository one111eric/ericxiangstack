---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";

export async function getStaticPaths() {
  const guides = await getCollection("poe");
  return guides.map((guide) => ({
    params: { id: guide.id },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);
const { title, description, tags, updated } = guide.data;
---

<BaseLayout title={title} description={description}>
  <PageHeader eyebrow="PoE Guide" title={title} subtitle={description} />

  <section class="container-page py-12">
    <div class="mb-6 flex flex-wrap items-center gap-3 text-sm">
      {
        updated && (
          <time class="text-ink-500" datetime={updated.toISOString()}>
            Updated {updated.toLocaleDateString("en-US", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })}
          </time>
        )
      }
      {tags.map((t) => <span class="tag">{t}</span>)}
    </div>

    <article
      class="prose prose-slate max-w-3xl dark:prose-invert"
    >
      <Content />
    </article>

    <div class="mt-12">
      <a href="/poe" class="text-sm font-medium text-brand-600 hover:underline dark:text-brand-300">
        &larr; Back to PoE resources
      </a>
    </div>
  </section>
</BaseLayout>
