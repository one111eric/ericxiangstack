---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";

const guides = (await getCollection("poe")).sort((a, b) => {
  const av = a.data.updated?.valueOf() ?? 0;
  const bv = b.data.updated?.valueOf() ?? 0;
  return bv - av;
});

const resources = [
  {
    title: "Live Currency Prices",
    description: "Real-time chaos values for currency, pulled from poe.ninja.",
    href: "/poe/currency",
    internal: true,
  },
  {
    title: "poe.ninja",
    description: "Economy data, builds, and league stats.",
    href: "https://poe.ninja",
    internal: false,
  },
  {
    title: "Path of Building",
    description: "The essential build planner for Path of Exile.",
    href: "https://pathofbuilding.community",
    internal: false,
  },
  {
    title: "Official Trade",
    description: "Search the in-game marketplace.",
    href: "https://www.pathofexile.com/trade",
    internal: false,
  },
];
---

<BaseLayout
  title="Path of Exile"
  description="Path of Exile resources, references, and live economy data."
>
  <PageHeader
    eyebrow="Path of Exile"
    title="PoE resources"
    subtitle="Tools, references, and live data for my favorite ARPG."
  />

  <section class="container-page py-12">
    <h2 class="mb-6 text-xl font-bold">Resources</h2>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        resources.map((r) => (
          <a
            href={r.href}
            target={r.internal ? undefined : "_blank"}
            rel={r.internal ? undefined : "noopener noreferrer"}
            class="card group"
          >
            <div class="flex items-center justify-between">
              {!r.internal && <span class="text-xs text-ink-400">External</span>}
              {r.internal && <span class="tag">Live</span>}
            </div>
            <h3 class="mt-3 text-lg font-semibold group-hover:text-brand-600 dark:group-hover:text-brand-300">
              {r.title}
            </h3>
            <p class="mt-2 text-sm text-ink-600 dark:text-ink-300">
              {r.description}
            </p>
          </a>
        ))
      }
    </div>

    {
      guides.length > 0 && (
        <>
          <h2 class="mb-6 mt-14 text-xl font-bold">Guides</h2>
          <div class="grid gap-6 md:grid-cols-2">
            {guides.map((g) => (
              <a href={`/poe/${g.id}`} class="card group">
                <h3 class="text-lg font-semibold group-hover:text-brand-600 dark:group-hover:text-brand-300">
                  {g.data.title}
                </h3>
                <p class="mt-2 text-sm text-ink-600 dark:text-ink-300">
                  {g.data.description}
                </p>
                {g.data.tags.length > 0 && (
                  <div class="mt-4 flex flex-wrap gap-2">
                    {g.data.tags.map((t) => (
                      <span class="tag">{t}</span>
                    ))}
                  </div>
                )}
              </a>
            ))}
          </div>
        </>
      )
    }
  </section>
</BaseLayout>
