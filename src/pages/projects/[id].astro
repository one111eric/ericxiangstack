---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, description, tags, repo, demo, date } = project.data;
---

<BaseLayout title={title} description={description}>
  <PageHeader eyebrow="Project" title={title} subtitle={description} />

  <section class="container-page py-12">
    <div class="mb-6 flex flex-wrap items-center gap-3 text-sm">
      <time class="text-ink-500" datetime={date.toISOString()}>
        {date.toLocaleDateString("en-US", { year: "numeric", month: "long" })}
      </time>
      {tags.map((t) => <span class="tag">{t}</span>)}
    </div>

    {
      (repo || demo) && (
        <div class="mb-8 flex gap-3">
          {demo && (
            <a class="btn-primary" href={demo} target="_blank" rel="noopener noreferrer">
              Live demo
            </a>
          )}
          {repo && (
            <a class="btn-ghost" href={repo} target="_blank" rel="noopener noreferrer">
              Source
            </a>
          )}
        </div>
      )
    }

    <article
      class="prose-links max-w-3xl space-y-4 leading-relaxed text-ink-700
        dark:text-ink-300"
    >
      <Content />
    </article>

    <div class="mt-12">
      <a href="/projects" class="text-sm font-medium text-brand-600 hover:underline dark:text-brand-300">
        &larr; Back to all projects
      </a>
    </div>
  </section>
</BaseLayout>
