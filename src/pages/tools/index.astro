---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import ToolCard from "../../components/ToolCard.astro";
import { tools, toolCategories } from "../../lib/tools";

const usedCategories = toolCategories.filter((c) =>
  tools.some((t) => t.category === c),
);
---

<BaseLayout
  title="Tools"
  description="A growing kit of fast, privacy-friendly web utilities."
>
  <PageHeader
    eyebrow="Tools"
    title="Useful web tools"
    subtitle="Fast, no-nonsense utilities that run right in your browser. Nothing leaves your device."
  />

  <section class="container-page py-12">
    <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <input
        id="tool-search"
        type="search"
        placeholder="Search tools..."
        class="field sm:max-w-xs"
        aria-label="Search tools"
      />
      <div id="tool-filters" class="flex flex-wrap gap-2">
        <button class="btn-ghost !py-1.5 !text-xs" data-cat="all" aria-pressed="true">
          All
        </button>
        {
          usedCategories.map((c) => (
            <button class="btn-ghost !py-1.5 !text-xs" data-cat={c} aria-pressed="false">
              {c}
            </button>
          ))
        }
      </div>
    </div>

    <div id="tools-grid" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        tools.map((t) => (
          <ToolCard
            title={t.title}
            description={t.description}
            href={`/tools/${t.slug}`}
            category={t.category}
            available={t.available}
          />
        ))
      }
    </div>

    <p id="tools-empty" class="hidden py-12 text-center text-ink-500">
      No tools match your search.
    </p>
  </section>
</BaseLayout>

<script>
  const search = document.getElementById("tool-search") as HTMLInputElement | null;
  const grid = document.getElementById("tools-grid");
  const empty = document.getElementById("tools-empty");
  const filterButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>("#tool-filters button"),
  );
  const cards = Array.from(
    grid?.querySelectorAll<HTMLElement>("[data-title]") ?? [],
  );

  let activeCat = "all";
  let query = "";

  function apply() {
    let visible = 0;
    for (const card of cards) {
      const title = (card.dataset.title ?? "").toLowerCase();
      const cat = card.dataset.category ?? "";
      const matchesCat = activeCat === "all" || cat === activeCat;
      const matchesQuery = title.includes(query);
      const show = matchesCat && matchesQuery;
      card.classList.toggle("hidden", !show);
      if (show) visible++;
    }
    empty?.classList.toggle("hidden", visible !== 0);
  }

  search?.addEventListener("input", () => {
    query = search.value.trim().toLowerCase();
    apply();
  });

  filterButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      activeCat = btn.dataset.cat ?? "all";
      filterButtons.forEach((b) =>
        b.setAttribute("aria-pressed", String(b === btn)),
      );
      filterButtons.forEach((b) =>
        b.classList.toggle("!bg-brand-600", b === btn),
      );
      filterButtons.forEach((b) =>
        b.classList.toggle("!text-white", b === btn),
      );
      apply();
    });
  });
</script>
